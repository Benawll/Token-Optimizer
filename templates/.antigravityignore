.git/
.svn/
.hg/
.DS_Store
Thumbs.db
desktop.ini

# --- Dépendances & Environnements ---
node_modules/
bower_components/
jspm_packages/
.venv/
venv/
env/
.conda/
__pypackages__/
vendor/
Pods/
.gradle/
.m2/

